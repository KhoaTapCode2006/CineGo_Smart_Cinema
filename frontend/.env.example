# CineGo Smart Cinema Environment Variables
# Base URL for the FastAPI backend (all endpoints are prefixed with /api/v1)
VITE_API_URL=http://localhost:8000/api/v1

# Real-time WebSocket server URL
VITE_SOCKET_URL=http://localhost:8000

# Set to true to force local mock dataset fallback during UI design & testing
VITE_USE_MOCK=false
